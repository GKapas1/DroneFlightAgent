<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_custom_lidar_side">
    <link name="lidar_side_link">
      <sensor name="lidar_side" type="gpu_lidar">
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <topic>/x500_custom/lidar/side</topic>

        <lidar>
          <scan>
            <horizontal>
              <samples>1024</samples>
              <resolution>1</resolution>
              <min_angle>-1.5708</min_angle>
              <max_angle>1.5708</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.10</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <joint name="lidar_side_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_side_link</child>
      <!-- rotate 90deg if you want it pointing sideways -->
      <pose relative_to="base_link">0 0.20 0.05 0 0 1.5708</pose>
    </joint>
  </model>
</sdf>
