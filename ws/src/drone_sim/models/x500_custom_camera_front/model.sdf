<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_custom_camera_front">
    <!-- Link that only contains the camera sensor -->
    <link name="camera_front_link">
      <!-- Match your previous topic -->
      <sensor name="cam_front" type="camera">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>/x500_custom/camera/image</topic>

        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <!-- Attach to base_link from x500_base -->
    <joint name="camera_front_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_front_link</child>
      <!-- tweak pose to match your previous placement -->
      <pose relative_to="base_link">0.12 0.03 0.242 0 0 0</pose>
    </joint>
  </model>
</sdf>
